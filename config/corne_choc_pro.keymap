// ╭──────────┬──────────┬──────────────┬───────────────┬────────────────┬─────────────┬──────────╮╭──────────┬──────────┬────────────────┬────────────────┬───────────────┬──────────┬──────────╮
    &none      &none      &kp HOME       &kp UP          &kp END          &kp PG_UP     &none       &trans     &trans     &kp KP_N7        &kp KP_N8        &kp KP_N9       &none      &none
// ├──────────┼──────────┼──────────────┼───────────────┼────────────────┼─────────────┼──────────┤├──────────┼──────────┼────────────────┼────────────────┼───────────────┼──────────┼──────────┤
    &none      &none      &hml LALT LEFT &hml LCTRL DOWN &hml LSHFT RIGHT &kp PG_DN     &none       &trans     &trans     &hmr RSHFT KP_N4 &hmr RCTRL KP_N5 &hmr RALT KP_N6 &none      &none
// ├──────────┼──────────┼──────────────┼───────────────┼────────────────┼─────────────┼──────────╯╰──────────┼──────────┼────────────────┼────────────────┼───────────────┼──────────┼──────────┤
    &none      &none      &none          &none           &none            &none                                &trans     &kp KP_N1        &kp KP_N2        &kp KP_N3       &none      &none
// ╰──────────┴──────────┴──────────────┼───────────────┼────────────────┼─────────────┤                      ├──────────┼────────────────┼────────────────┼───────────────┴──────────┴──────────╯
                                         &trans          &trans           &trans                               &trans     &trans           &kp KP_N0
//                                      ╰───────────────┴────────────────┴─────────────╯                      ╰──────────┴────────────────┴────────────────╯
>; }; */

navnum_layer {  display-name = "Nav-Num";  bindings = <
// ╭──────────┬────────────────┬─────────────────┬────────────────┬─────────────────┬─────────────┬──────────╮╭──────────┬──────────┬────────────────┬────────────────┬───────────────┬────────────────┬──────────╮
    &kp N0     &kp N1           &kp N2            &kp N3           &kp N4            &kp N5        &trans      &trans     &trans     &kp N6           &kp N7           &kp N8          &kp N9           &kp N0
// ├──────────┼────────────────┼─────────────────┼────────────────┼─────────────────┼─────────────┼──────────┤├──────────┼──────────┼────────────────┼────────────────┼───────────────┼────────────────┼──────────┤
    &trans     &trans           &trans            &trans           &trans            &trans        &trans      &trans     &trans     &hmr RSHFT LEFT  &hmr RCTRL DOWN  &hmr RALT UP    &hmrg RGUI RIGHT &none
// ├──────────┼────────────────┼─────────────────┼────────────────┼─────────────────┼─────────────┼──────────╯╰──────────┼──────────┼────────────────┼────────────────┼───────────────┼────────────────┼──────────┤
    &trans     &kp LG(LS(LEFT)) &kp LG(LS(RIGHT)) &kp LG(LC(LEFT)) &kp LG(LC(RIGHT)) &trans                               &trans     &kp HOME         &kp PG_DN        &kp PG_UP       &kp END          &trans
// ╰──────────┴────────────────┴─────────────────┼────────────────┼─────────────────┼─────────────┤                      ├──────────┼────────────────┼────────────────┼───────────────┴────────────────┴──────────╯
                                                  &trans           &trans            &trans                               &trans     &trans           &trans
//                                               ╰────────────────┴─────────────────┴─────────────╯                      ╰──────────┴────────────────┴────────────────╯
>; };

fkeys_layer {  display-name = "FKeys";  bindings = <
// ╭──────────┬──────────┬───────────┬──────────┬──────────┬──────────┬───────────╮╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮
    &kp SLCK   &kp PAUSBR &kp INS     &kp CAPS   &kp PSCRN  &none      &kp C_VOL_UP &kp K_PP   &none      &kp F1     &kp F2     &kp F3     &kp F4     &kp F15
// ├──────────┼──────────┼───────────┼──────────┼──────────┼──────────┼───────────┤├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
    &none      &kp LGUI   &kp LALT    &kp LCTRL  &kp LSHFT  &none      VOLDN_MUT        &none  &none      &kp F5     &kp F6     &kp F7     &kp F8     &kp F14
// ├──────────┼──────────┼───────────┼──────────┼──────────┼──────────┼───────────╯╰──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
    &none      &none      &none       &none      &none      &none                              &none      &kp F9     &kp F10    &kp F11    &kp F12    &kp F13
// ╰──────────┴──────────┴───────────┼──────────┼──────────┼──────────┤                       ├──────────┼──────────┼──────────┼──────────┴──────────┴──────────╯
                                      &trans     &trans     &trans                             &trans     &trans     &trans
//                                   ╰──────────┴──────────┴──────────╯                       ╰──────────┴──────────┴──────────╯
>; };


