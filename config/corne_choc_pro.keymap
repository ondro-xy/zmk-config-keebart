#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};


#include "corne_combos_lr.dtsi"


/ {
    behaviors {
        #include "mod_morphs.dtsi"
    };
};


/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
            // ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮
                &kp GRAVE  &kp B      &kp Y      &kp O      &kp U      &kp SQT    &kp LCTRL   &kp BSPC   &min_plu   &kp L      &kp D      &kp W      &kp V      &kp Z
            // ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
                &eq_star   &kp C      &kp I      &kp E      &kp A      &com_sec   &kp LALT    &kp DEL    &dot_col   &kp H      &kp T      &kp S      &kp N      &kp Q
            // ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────╯╰──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
                &kp LGUI   &kp G      &kp X      &kp J      &kp K      &q_ex                             &sl_bsl    &kp R      &kp M      &kp F      &kp P      &mo 1
            // ╰──────────┴──────────┴──────────┼──────────┼──────────┼──────────┤                      ├──────────┼──────────┼──────────┼──────────┴──────────┴──────────╯
                                                 &kp LSHFT  &kp ESC    &kp RET                           &kp SPACE  &kp TAB    &kp RSHFT
            //                                  ╰──────────┴──────────┴──────────╯                      ╰──────────┴──────────┴──────────╯
            >;
        };

        sys_layer {
            display-name = "System";
            bindings = <
            // ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮╭──────────┬──────────┬──────────┬──────────┬──────────┬────────────┬────────────╮
                &none      &none      &none      &none      &none      &none      &bootloader &none      &none      &none      &none      &none      &bt BT_SEL 0 &bt BT_SEL 1
            // ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤├──────────┼──────────┼──────────┼──────────┼──────────┼────────────┼────────────┤
                &none      &none      &none      &none      &none      &none      &sys_reset  &bt BT_CLR &none      &none      &none      &none      &bt BT_SEL 2 &bt BT_SEL 3
            // ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────╯╰──────────┼──────────┼──────────┼──────────┼──────────┼────────────┼────────────┤
                &none      &none      &none      &none      &none      &none                             &none      &none      &none      &none      &bt BT_SEL 4 &transp
            // ╰──────────┴──────────┴──────────┼──────────┼──────────┼──────────┤                      ├──────────┴──────────┴──────────┴──────────┴────────────┴────────────╯
                                                 &none      &none      &none                             &rgb_ug RGB_TOG &rgb_ug RGB_BRI &rgb_ug RGB_BRD
            //                                  ╰──────────┴──────────┴──────────╯                      ╰───────────────┴───────────────┴───────────────╯
            >;
        };

        /*
        none_layer {
            display-name = "none";
            bindings = <
            // ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮
                &none      &none      &none      &none      &none      &none      &none       &none      &none      &none      &none      &none      &none      &none
            // ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
                &none      &none      &none      &none      &none      &none      &none       &none      &none      &none      &none      &none      &none      &none
            // ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────╯╰──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
                &none      &none      &none      &none      &none      &none                             &none      &none      &none      &none      &none      &none
            // ╰──────────┴──────────┴──────────┼──────────┼──────────┼──────────┤                      ├──────────┼──────────┼──────────┼──────────┴──────────┴──────────╯
                                                 &none      &none      &none                             &none      &none      &none
            //                                  ╰──────────┴──────────┴──────────╯                      ╰──────────┴──────────┴──────────╯
            >;
        };
        */
    };
};
