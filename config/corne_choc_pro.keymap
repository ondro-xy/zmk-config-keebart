#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};


#include "corne_labels.h"
#include "corne_combos_lr.dtsi"

#define PAUSBR PAUSE_BREAK
#define VOLDN &mt_vol C_MUTE C_VOL_DN

/ {
    behaviors {
        #include "mod_morphs.dtsi"

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_RIGHT KEYS_THUMB_R LH0>; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_LEFT KEYS_THUMB_L RH0>; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };
        hmlg: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <580>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_RIGHT KEYS_THUMB_R LH0>; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };
        hmrg: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <580>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_LEFT KEYS_THUMB_L RH0>; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };

        mt_vol: voldn_mute {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            bindings = <&kp>, <&kp>;
            display-name = "Mod-Tap";
        };
    };
};


/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
            // ╭──────────┬────────────┬────────────┬────────────┬────────────┬──────────┬───────────╮╭──────────┬──────────┬────────────┬────────────┬────────────┬────────────┬──────────╮
                &kp GRAVE  &kp B        &kp Y        &kp O        &kp U        &kp SQT    &kp C_VOL_UP &kp BSPC   &min_plu   &kp L        &kp D        &kp W        &kp V        &kp Z
            // ├──────────┼────────────┼────────────┼────────────┼────────────┼──────────┼───────────┤├──────────┼──────────┼────────────┼────────────┼────────────┼────────────┼──────────┤
                &eq_star   &hmlg LGUI C &hml LALT I  &hml LCTRL E &hml LSHFT A &com_sec   VOLDN        &kp DEL    &dot_col   &hmr RSHFT H &hmr RCTRL T &hmr RALT S  &hmrg RGUI N &kp Q
            // ├──────────┼────────────┼────────────┼────────────┼────────────┼──────────┼───────────╯╰──────────┼──────────┼────────────┼────────────┼────────────┼────────────┼──────────┤
                &none      &kp G        &kp X        &kp J        &kp K        &q_ex                              &sl_star   &kp R        &kp M        &kp F        &kp P        &none
            // ╰──────────┴────────────┴────────────┼────────────┼────────────┼──────────┤                       ├──────────┼────────────┼────────────┼────────────┴────────────┴──────────╯
                                                     &none        &lt 2 ESC    &kp RET                            &kp SPACE  &lt 3 TAB    &mo 1
            //                                      ╰────────────┴────────────┴──────────╯                       ╰──────────┴────────────┴────────────╯
            >;
        };

        sys_layer {
            display-name = "System";
            bindings = <
            // ╭───────────────┬───────────────┬───────────────┬──────────┬──────────┬──────────┬──────────╮╭──────────┬─────────────┬─────────────┬─────────────┬─────────────┬────────────┬────────────╮
                &none           &none           &none           &none      &none      &none      &bootloader &none      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4 &none
            // ├───────────────┼───────────────┼───────────────┼──────────┼──────────┼──────────┼──────────┤├──────────┼─────────────┼─────────────┼─────────────┼─────────────┼────────────┼────────────┤
                &none           &none           &none           &none      &none      &none      &sys_reset  &bt BT_CLR &none         &none         &none         &none         &none        &none
            // ├───────────────┼───────────────┼───────────────┼──────────┼──────────┼──────────┼──────────╯╰──────────┼─────────────┼─────────────┼─────────────┼─────────────┼────────────┼────────────┤
                &rgb_ug RGB_TOG &rgb_ug RGB_BRI &rgb_ug RGB_BRD &none      &none      &none                             &none         &none         &none         &none         &none        &none
            // ╰───────────────┴───────────────┴───────────────┼──────────┼──────────┼──────────┤                      ├─────────────┴─────────────┴─────────────┴─────────────┴────────────┴────────────╯
                                                                &trans     &trans     &trans                            &trans        &trans        &trans
            //                                                 ╰──────────┴──────────┴──────────╯                      ╰─────────────┴─────────────┴─────────────╯
            >;
        };

        navnum_lr_layer {
            display-name = "NavNum_LR";
            bindings = <
            // ╭──────────┬──────────┬──────────────┬───────────────┬────────────────┬─────────────┬──────────╮╭──────────┬──────────┬────────────────┬────────────────┬───────────────┬──────────┬──────────╮
                &none      &none      &kp HOME       &kp UP          &kp END          &kp PG_UP     &none       &trans     &trans     &kp KP_N7        &kp KP_N8        &kp KP_N9       &none      &none
            // ├──────────┼──────────┼──────────────┼───────────────┼────────────────┼─────────────┼──────────┤├──────────┼──────────┼────────────────┼────────────────┼───────────────┼──────────┼──────────┤
                &none      &none      &hml LALT LEFT &hml LCTRL DOWN &hml LSHFT RIGHT &kp PG_DN     &none       &trans     &trans     &hmr RSHFT KP_N4 &hmr RCTRL KP_N5 &hmr RALT KP_N6 &none      &none
            // ├──────────┼──────────┼──────────────┼───────────────┼────────────────┼─────────────┼──────────╯╰──────────┼──────────┼────────────────┼────────────────┼───────────────┼──────────┼──────────┤
                &none      &none      &none          &none           &none            &none                                &trans     &kp KP_N1        &kp KP_N2        &kp KP_N3       &none      &none
            // ╰──────────┴──────────┴──────────────┼───────────────┼────────────────┼─────────────┤                      ├──────────┼────────────────┼────────────────┼───────────────┴──────────┴──────────╯
                                                     &trans          &trans           &trans                               &trans     &trans           &kp KP_N0
            //                                      ╰───────────────┴────────────────┴─────────────╯                      ╰──────────┴────────────────┴────────────────╯
            >;
        };

        fkeys_layer {
            display-name = "FKeys";
            bindings = <
            // ╭──────────┬──────────┬───────────┬──────────┬──────────┬──────────┬───────────╮╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮
                &kp SLCK   &kp PAUSBR &kp INS     &kp CAPS   &kp PSCRN  &none      &kp C_VOL_UP &kp K_PP   &none      &kp F1     &kp F2     &kp F3     &kp F4     &kp F15
            // ├──────────┼──────────┼───────────┼──────────┼──────────┼──────────┼───────────┤├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
                &kp KP_NUM &kp LGUI   &kp LALT    &kp LCTRL  &kp LSHFT  &none      VOLDN        &none      &none      &kp F5     &kp F6     &kp F7     &kp F8     &kp F14
            // ├──────────┼──────────┼───────────┼──────────┼──────────┼──────────┼───────────╯╰──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
                &none      &none      &kp K_CMENU &none      &none      &none                              &none      &kp F9     &kp F10    &kp F11    &kp F12    &kp F13
            // ╰──────────┴──────────┴───────────┼──────────┼──────────┼──────────┤                       ├──────────┼──────────┼──────────┼──────────┴──────────┴──────────╯
                                                  &trans     &trans     &trans                             &trans     &trans     &trans
            //                                   ╰──────────┴──────────┴──────────╯                       ╰──────────┴──────────┴──────────╯
            >;
        };


        /*
        none_layer {
            display-name = "none";
            bindings = <
            // ╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮
                &none      &none      &none      &none      &none      &none      &none       &none      &none      &none      &none      &none      &none      &none
            // ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
                &none      &none      &none      &none      &none      &none      &none       &none      &none      &none      &none      &none      &none      &none
            // ├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────╯╰──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
                &none      &none      &none      &none      &none      &none                             &none      &none      &none      &none      &none      &none
            // ╰──────────┴──────────┴──────────┼──────────┼──────────┼──────────┤                      ├──────────┼──────────┼──────────┼──────────┴──────────┴──────────╯
                                                 &none      &none      &none                             &none      &none      &none
            //                                  ╰──────────┴──────────┴──────────╯                      ╰──────────┴──────────┴──────────╯
            >;
        };
        */
    };
};
