#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};


/* Layers */
#define Base     0
#define Sys      1
#define FKeys    2
#define NavNum   3
#define Nav      4
#define Num      5
#define NumKp    6

#include "incl/corne_labels.h"
#include "incl/combos_lr.dtsi"
#include "incl/morphs.dtsi"
#include "incl/behaviors.dtsi"

#define __         &trans
#define xx         &none
#define PAUSEB     &kp PAUSE_BREAK

#define VOLDN_MUT  &mttl C_MUTE       C_VOL_DN
#define VOLUP_PLAY &mttl C_PLAY_PAUSE C_VOL_UP
#define BSPC_W     &mtts LC(BSPC)     BSPC
#define DEL_W      &mtts LC(DEL)      DEL

#define DESK_LEFT  &kp LG(LS(LEFT))
#define DESK_RIGHT &kp LG(LS(RIGHT))
#define DESK_PREV  &kp LG(LS(LEFT))
#define DESK_NEXT  &kp LG(LS(RIGHT))

/ {
    keymap {
        compatible = "zmk,keymap";


base_layer {  display-name = "Base";  bindings = <
// ╭──────────┬────────────┬────────────┬────────────┬─────────────┬──────────┬───────────╮╭───────────┬──────────┬──────────────┬────────────┬────────────┬────────────┬──────────╮
    &kp GRAVE  &kp B        &kp Y        &kp O        &kp U         &kp SQT    VOLUP_PLAY   BSPC_W      &min_plu   &kp L          &kp D        &kp W        &kp V        &kp Z
// ├──────────┼────────────┼────────────┼────────────┼─────────────┼──────────┼───────────┤├───────────┼──────────┼──────────────┼────────────┼────────────┼────────────┼──────────┤
    &eq_ex     HML(C,           I,           E,           A)        &com_sem   VOLDN_MUT    DEL_W       &dot_col   HMR(H,             T,           S,           N)       &kp Q
// ├──────────┼────────────┼────────────┼────────────┼─────────────┼──────────┼───────────╯╰───────────┼──────────┼──────────────┼────────────┼────────────┼────────────┼──────────┤
    xx         &kp G        &kp X        &kp J        &kp K         &q_ex                               &sl_star   &kp R          &kp M        &kp F        &kp P        &kp K_CMENU
// ╰──────────┴────────────┴────────────┼────────────┼─────────────┼──────────┤                        ├──────────┼──────────────┼────────────┼────────────┴────────────┴──────────╯
                                         &lcw Sys 0   &lt Num ESC   &kp SPACE                           &kp SPACE  &lt Nav TAB    &lcw FKeys 0
//                                      ╰────────────┴─────────────┴──────────╯                        ╰──────────┴──────────────┴────────────╯
>; };

sys_layer {  display-name = "System";  bindings = <
// ╭───────────────┬───────────────┬───────────────┬────────────┬─────────────┬──────────┬──────────╮╭──────────────┬─────────────┬─────────────┬─────────────┬─────────────┬────────────┬────────────╮
    &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3  &bt BT_SEL 4 xx         &bootloader &studio_unlock xx            xx            xx            xx            xx           xx   
// ├───────────────┼───────────────┼───────────────┼────────────┼─────────────┼──────────┼──────────┤├──────────────┼─────────────┼─────────────┼─────────────┼─────────────┼────────────┼────────────┤
    xx              xx              xx              xx           xx            xx         &sys_reset  &bt BT_CLR     xx            xx            xx            xx            xx           xx   
// ├───────────────┼───────────────┼───────────────┼────────────┼─────────────┼──────────┼──────────╯╰──────────────┼─────────────┼─────────────┼─────────────┼─────────────┼────────────┼────────────┤
    &rgb_ug RGB_TOG &rgb_ug RGB_BRI &rgb_ug RGB_BRD xx           xx            xx                                    xx            xx            xx            xx            xx           xx   
// ╰───────────────┴───────────────┴───────────────┼────────────┼─────────────┼──────────┤                          ├─────────────┴─────────────┴─────────────┴─────────────┴────────────┴────────────╯
                                                    __           __            __                                    __            __            __    
//                                                 ╰────────────┴─────────────┴──────────╯                          ╰─────────────┴─────────────┴─────────────╯
>; };

fkeys_layer {  display-name = "FKeys";  bindings = <
// ╭──────────┬──────────┬───────────┬──────────┬──────────┬──────────┬───────────╮╭──────────┬──────────┬──────────┬──────────┬──────────┬──────────┬──────────╮
    &kp SLCK   PAUSEB     &kp INS     &kp CAPS   &kp PSCRN  xx         VOLUP_PLAY   xx         xx         &kp F1     &kp F2     &kp F3     &kp F4     &kp F15
// ├──────────┼──────────┼───────────┼──────────┼──────────┼──────────┼───────────┤├──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
    xx         &kp LGUI   &kp LALT    &kp LCTRL  &kp LSHFT  xx         VOLDN_MUT    xx         xx         &kp F5     &kp F6     &kp F7     &kp F8     &kp F14
// ├──────────┼──────────┼───────────┼──────────┼──────────┼──────────┼───────────╯╰──────────┼──────────┼──────────┼──────────┼──────────┼──────────┼──────────┤
    xx         xx         xx          xx         xx         xx                                 xx         &kp F9     &kp F10    &kp F11    &kp F12    &kp F13
// ╰──────────┴──────────┴───────────┼──────────┼──────────┼──────────┤                       ├──────────┼──────────┼──────────┼──────────┴──────────┴──────────╯
                                      __         __         __                                 __         __         __    
//                                   ╰──────────┴──────────┴──────────╯                       ╰──────────┴──────────┴──────────╯
>; };

navnum_layer {  display-name = "Nav-Num";  bindings = <
// ╭──────────┬───────────┬────────────┬───────────┬──────────────┬─────────┬──────────╮╭──────────┬──────────┬──────────┬──────────┬──────────┬───────────┬──────────╮
    &kp N0     &kp N1      &kp N2       &kp N3      &kp N4         &kp N5    __          __         __         &kp N6     &kp N7     &kp N8     &kp N9      &kp N0
// ├──────────┼───────────┼────────────┼───────────┼──────────────┼─────────┼──────────┤├──────────┼──────────┼──────────┼──────────┼──────────┼───────────┼──────────┤
    __         __          __           __          &hml LSHFT N5  __        __          __         &kp LEFT   HMR(UP,    DOWN,      RIGHT,     RIGHT)      xx   
// ├──────────┼───────────┼────────────┼───────────┼──────────────┼─────────┼──────────╯╰──────────┼──────────┼──────────┼──────────┼──────────┼───────────┼──────────┤
    __         DESK_LEFT   DESK_RIGHT   DESK_PREV   DESK_NEXT      __                               &kp HOME   &kp PG_UP  &kp PG_DN  &kp END    xx          __
// ╰──────────┴───────────┴────────────┼───────────┼──────────────┼─────────┤                      ├──────────┼──────────┼──────────┼──────────┴───────────┴──────────╯
                                        __          __             __                               __         __         __    
//                                     ╰───────────┴──────────────┴─────────╯                      ╰──────────┴──────────┴──────────╯
>; };

