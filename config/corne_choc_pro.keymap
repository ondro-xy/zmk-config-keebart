#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

#include "corne_labels.h"

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};

#include "corne_combos_1.dtsi"

/ {
    behaviors {

        #include "mod_morphs.dtsi"

        dot_col: dot_colon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp COLON>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            // keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        sl_bsl: slash_backslash {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp BACKSLASH>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        cm_sc: comma_semicolon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp SEMICOLON>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        q_ex: question_exclamation {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp QUESTION>, <&kp EXCLAMATION >;
            mods = <(MOD_LSFT|MOD_RSFT)>;
            // keep-mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            // ╭-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----╮
            // │ ` ~ │  b  │  y  │  o  │  u  │ '"  │     │ BSpc│  -+ │  l  │  d  │  w  │  v  │  z  │
            // │ = * │  c  │  i  │  e  │  a  │ ,;  │     │ Del │  .: │  h  │  t  │  s  │  n  │  q  │
            // │     │  g  │  x  │  j  │  k  │ ?!  ├-----┴-----┤  /\ │  r  │  m  │  f  │  p  │     │
            // ╰-----┴-----┴-----┤     │ Esc │ Ret │           │ Spc │ Tab │     ├-----┴-----┴-----╯
            //                   ╰-----┴-----┴-----╯           ╰-----┴-----┴-----╯
            bindings = <
                &kp GRAVE &kp B &kp Y &kp O    &kp U   &kp SQT &none  &kp BSPC &min_pl   &kp L   &kp D &kp W &kp V &kp Z
                &eq_star  &kp C &kp I &kp E    &kp A   &cm_sc  &none  &kp DEL  &dot_col  &kp H   &kp T &kp S &kp N &kp Q
                &none     &kp G &kp X &kp J    &kp K   &q_ex                   &sl_bsl   &kp R   &kp M &kp F &kp P &none
                                      &kp LGUI &kp ESC &kp RET                 &kp SPACE &kp TAB &none
            >;
            // sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN &inc_dec_kp C_PREV C_NEXT &inc_dec_kp C_BRI_DN C_BRI_UP>;
        };

        navnum_layer {
            display-name = "NavNum";
            // ╭-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----╮
            // │D.Lef│D.Rig│ Home│  Up │ End │ PgUp│     │  ▽  │  ▽  │  7  │  8  │  9  │  *  │  /  │
            // │A-Tab│     │ Lef │ Down│ Righ│ PgDn│     │  ▽  │  ▽  │  4  │  5  │  6  │  +  │  -  │
            // │     │     │C-PgU│C-Tab│C-PgD│     ├-----┴-----┤  ▽  │  1  │  2  │  3  │  ,  │  .  │
            // ╰-----┴-----┴-----┤  ▽  │  ▽  │  ▽  │           │  ▽  │  ▽  │  0  ├-----┴-----┴-----╯
            //                   ╰-----┴-----┴-----╯           ╰-----┴-----┴-----╯
            bindings = <
                &none &none &kp HOME &kp UP   &kp END   &kp PG_UP &none  &trans &trans &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_MULTIPLY &kp KP_DIVIDE
                &none &none &kp LEFT &kp DOWN &kp RIGHT &kp PG_DN &none  &trans &trans &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_PLUS     &kp KP_MINUS
                &none &none &none    &none    &none     &none                   &trans &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_COMMA    &kp KP_DOT
                                     &trans   &trans    &trans                  &trans &trans    &kp KP_N0
            >;
        };

        symbols_layer {
            display-name = "Symbols";
            // ╭-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----╮
            // │     │     │  @  │  #  │     │     │     │  ▽  │     │  *  │  |  │  &  │     │     │
            // │     │     │  $  │  ^  │  %  │     │     │  ▽  │  _  │  [  │  ]  │  <  │  >  │     │
            // │     │     │     │  _  │     │     ├-----┴-----┤  \  │  (  │  )  │  {  │  }  │     │
            // ╰-----┴-----┴-----┤  ▽  │  ▽  │  ▽  │           │  ▽  │  ▽  │  ▽  ├-----┴-----┴-----╯
            //                   ╰-----┴-----┴-----╯           ╰-----┴-----┴-----╯
            bindings = <
                &none &none &kp AT   &kp HASH  &none     &none  &none  &trans &none     &kp STAR &kp PIPE &kp AMPS &none    &none
                &none &none &kp DLLR &kp CARET &kp PRCNT &none  &none  &trans &kp UNDER &kp LBKT &kp RBKT &kp LT   &kp GT   &none
                &none &none &none    &kp UNDER &none     &none                &kp BSLH  &kp LPAR &kp RPAR &kp LBRC &kp RBRC &none
                                     &trans    &trans    &trans               &trans    &trans   &trans
            >;
        };

        fkeys_layer {
            display-name = "FKeys";
            // ╭-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----╮
            // │ScrLk│Pause│ Ins │Caps │PrtSc│     │ vol+│ play│     │ F1  │ F2  │ F3  │ F4  │     │
            // │NumLk│ Gui │ Alt │Shift│Ctrl │     │ vol-│     │     │ F5  │ F6  │ F7  │ F8  │     │
            // │  ▽  │     │     │     │     │     ├-----┴-----┤     │ F9  │ F10 │ F11 │ F12 │     │
            // ╰-----┴-----┴-----┤  ▽  │  ▽  │  ▽  │           │  ▽  │  ▽  │  ▽  ├-----┴-----┴-----╯
            //                   ╰-----┴-----┴-----╯           ╰-----┴-----┴-----╯
            bindings = <
                &none  &none  &none  &none  &none  &none  &trans &none  &none  &kp F1 &kp F2  &kp F3  &kp F4  &none
                &none  &none  &none  &none  &none  &none  &trans &none  &none  &kp F5 &kp F6  &kp F7  &kp F8  &none
                &trans &none  &none  &none  &none  &none                &none  &kp F9 &kp F10 &kp F11 &kp F12 &kp F13
                                     &trans &trans &trans               &trans &trans &trans
            >;
        };

        bt_layer {
            display-name = "BlueTooth";
            // ╭-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----╮
            // │     │     │     │     │     │     │     │     │     │     │     │     │     │     │
            // │     │     │     │     │     │     │     │     │     │     │     │     │     │     │
            // │     │     │     │     │     │     ├-----┴-----┤     │     │     │     │     │     │
            // ╰-----┴-----┴-----┤     │     │     │           │     │     │     ├-----┴-----┴-----╯
            //                   ╰-----┴-----┴-----╯           ╰-----┴-----┴-----╯
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans               &trans &trans &trans &trans &trans &trans
                                     &trans &trans &trans               &trans &trans &trans
            >;
        };

        extra_layer_1 {
            display-name = "EXTRA 1";
            // ╭-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----╮
            // │     │     │     │     │     │     │     │     │     │     │     │     │     │     │
            // │     │     │     │     │     │     │     │     │     │     │     │     │     │     │
            // │     │     │     │     │     │     ├-----┴-----┤     │     │     │     │     │     │
            // ╰-----┴-----┴-----┤     │     │     │           │     │     │     ├-----┴-----┴-----╯
            //                   ╰-----┴-----┴-----╯           ╰-----┴-----┴-----╯
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none             &none &none &none &none &none &none
                                  &none &none &none             &none &none &none
            >;
        };

        extra_layer_2 {
            display-name = "EXTRA 2";
            // ╭-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----┬-----╮
            // │     │     │     │     │     │     │     │     │     │     │     │     │     │     │
            // │     │     │     │     │     │     │     │     │     │     │     │     │     │     │
            // │     │     │     │     │     │     ├-----┴-----┤     │     │     │     │     │     │
            // ╰-----┴-----┴-----┤     │     │     │           │     │     │     ├-----┴-----┴-----╯
            //                   ╰-----┴-----┴-----╯           ╰-----┴-----┴-----╯
            bindings = <
                &none &none &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none &none &none &none &none &none &none &none &none
                &none &none &none &none &none &none             &none &none &none &none &none &none
                                  &none &none &none             &none &none &none
            >;
        };
    };
};
