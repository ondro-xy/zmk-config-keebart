#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    chosen {
        zmk,physical-layout = &default_layout;
    };
};


#include "corne_labels.h"
#include "corne_combos_lr.dtsi"

/ {
    behaviors {
        #include "mod_morphs.dtsi"

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_RIGHT KEYS_THUMB_R LH0>; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_LEFT KEYS_THUMB_L RH0>; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };
        hmlg: home_row_mod_left_gui {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <580>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_RIGHT KEYS_THUMB_R LH0>; // List of keys on the right side of the keyboard
            hold-trigger-on-release;
        };
        hmrg: home_row_mod_right_gui {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <580>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <KEYS_LEFT KEYS_THUMB_L RH0>; // List of keys on the left side of the keyboard
            hold-trigger-on-release;
        };

        ht_media: ht_media_controls {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <500>;
            bindings = <&kp>, <&kp>;
            display-name = "HoldTab Media Controlos";
        };
    };
};

#define PAUSBR PAUSE_BREAK
#define VOLDN_MUT  &ht_media C_MUTE C_VOL_DN
#define VOLUP_PLAY &ht_media C_PLAY_PAUSE C_VOL_UP

/ {
    keymap {
        compatible = "zmk,keymap";

base_layer {  display-name = "Base";  bindings = <
// ╭──────────┬────────────┬────────────┬────────────┬────────────┬──────────┬───────────╮╭─────────────────┬──────────┬────────────┬────────────┬────────────┬────────────┬──────────╮
    &kp GRAVE  &kp B        &kp Y        &kp O        &kp U        &kp SQT    VOLUP_PLAY   &mt LC(BSPC) BSPC &min_plu   &kp L        &kp D        &kp W        &kp V        &kp Z
// ├──────────┼────────────┼────────────┼────────────┼────────────┼──────────┼───────────┤├─────────────────┼──────────┼────────────┼────────────┼────────────┼────────────┼──────────┤
    &eq_ex     &hmlg LGUI C &hml LALT I  &hml LCTRL E &hml LSHFT A &com_sec   VOLDN_MUT    &kp DEL           &dot_col   &hmr RSHFT H &hmr RCTRL T &hmr RALT S  &hmrg RGUI N &kp Q
// ├──────────┼────────────┼────────────┼────────────┼────────────┼──────────┼───────────╯╰─────────────────┼──────────┼────────────┼────────────┼────────────┼────────────┼──────────┤
    &none      &kp G        &kp X        &kp J        &kp K        &q_ex                                     &sl_star   &kp R        &kp M        &kp F        &kp P        &kp K_CMENU
// ╰──────────┴────────────┴────────────┼────────────┼────────────┼──────────┤                              ├──────────┼────────────┼────────────┼────────────┴────────────┴──────────╯
                                         &caps_word   &lt 3 ESC    &kp SPACE                                 &kp SPACE  &lt 2 TAB    &mo 1
//                                      ╰────────────┴────────────┴──────────╯                              ╰──────────┴────────────┴────────────╯
>; };

sys_layer {  display-name = "System";  bindings = <
// ╭───────────────┬───────────────┬───────────────┬──────────┬──────────┬──────────┬──────────╮╭──────────────┬─────────────┬─────────────┬─────────────┬─────────────┬────────────┬────────────╮
    &none           &none           &none           &none      &none      &none      &bootloader &studio_unlock &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4 &none
// ├───────────────┼───────────────┼───────────────┼──────────┼──────────┼──────────┼──────────┤├──────────────┼─────────────┼─────────────┼─────────────┼─────────────┼────────────┼────────────┤
    &none           &none           &none           &none      &none      &none      &sys_reset  &bt BT_CLR     &none         &none         &none         &none         &none        &none
// ├───────────────┼───────────────┼───────────────┼──────────┼──────────┼──────────┼──────────╯╰──────────────┼─────────────┼─────────────┼─────────────┼─────────────┼────────────┼────────────┤
    &rgb_ug RGB_TOG &rgb_ug RGB_BRI &rgb_ug RGB_BRD &none      &none      &none                                 &none         &none         &none         &none         &none        &none
// ╰───────────────┴───────────────┴───────────────┼──────────┼──────────┼──────────┤                          ├─────────────┴─────────────┴─────────────┴─────────────┴────────────┴────────────╯
                                                    &trans     &trans     &trans                                &trans        &trans        &trans
//                                                 ╰──────────┴──────────┴──────────╯                          ╰─────────────┴─────────────┴─────────────╯
>; };

